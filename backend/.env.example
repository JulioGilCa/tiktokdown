# ------------------------------------------------------------------
# TikTok Library - configuración del backend
# Copia este archivo a ".env" y rellena los valores.
# NUNCA subas el archivo .env a un repositorio.
# ------------------------------------------------------------------

# Entorno: development | production
APP_ENV=development
APP_NAME=TikTok Library

# URL pública desde la que se accede a la app (frontend + /api, mismo origen)
PUBLIC_BASE_URL=http://localhost:5173

# Base de datos (SQLite por defecto; PostgreSQL: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./data/library.db

# Carpeta raíz de almacenamiento multimedia (local o montaje del NAS Synology)
STORAGE_ROOT=./media

# Sesiones
SESSION_TTL_MINUTES=120
# En desarrollo sobre http://localhost se puede desactivar; en producción SIEMPRE true
COOKIE_SECURE=false

# Clave para cifrar tokens OAuth en reposo (Fernet, 32 bytes base64).
# Generar con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# TikTok Login Kit / Data Portability API (https://developers.tiktok.com)
# Requiere registrar una app y que TikTok apruebe los scopes solicitados.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/api/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,portability.activity.single

# Descargas
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_MAX_RETRIES=3
