# ==============================================================================
# Variables de entorno para despliegue con Docker Compose
# Copia este archivo a ".env" en la raíz del proyecto antes de arrancar.
# ==============================================================================

# Puerto en el host para acceder a la aplicación web (por defecto http://localhost:8080)
PORT=8080

# Credenciales de TikTok Developer (Login Kit & Data Portability API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/auth/tiktok/callback

# Clave Fernet (32 bytes url-safe base64) para cifrar los tokens OAuth en SQLite/PostgreSQL
# Generar en terminal con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Clave secreta para cookies de sesión firmadas
SESSION_SECRET_KEY=cambiar_por_una_cadena_secreta_aleatoria_larga_en_produccion

# Nivel de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Descargas concurrentes máximas hacia el almacenamiento (local / NAS)
MAX_CONCURRENT_DOWNLOADS=3

